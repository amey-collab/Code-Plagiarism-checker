{
  "name": "code-plagiarism-checker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install-all": "npm install --workspace=backend && npm install --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run start --workspace=backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
